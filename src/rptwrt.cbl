       IDENTIFICATION DIVISION.
       PROGRAM-ID. RPTWRT.
      *
      * RPTWRT - PRINTS THE ACCOUNT LIST AT THE END OF A RUN.
      *
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT REPORT-FILE ASSIGN TO WS-PATH
               ORGANIZATION IS LINE SEQUENTIAL.
       DATA DIVISION.
       FILE SECTION.
       FD  REPORT-FILE.
       01  REPORT-REC           PIC X(80).
       WORKING-STORAGE SECTION.
       01  WS-PATH              PIC X(100).
       01  WS-IX                PIC 9(4) COMP.
       01  WS-TOT-CHECKING      PIC S9(11)V99 VALUE 0.
       01  WS-TOT-SAVINGS       PIC S9(11)V99 VALUE 0.
       01  WS-N-FROZEN          PIC 9(4) COMP VALUE 0.
       01  WS-N-CLOSED          PIC 9(4) COMP VALUE 0.
       01  WS-LINE-COUNT        PIC 9(3) COMP VALUE 0.
       01  WS-PAGE-NO           PIC 9(3) COMP VALUE 0.
       01  WS-PAGE-SIZE         PIC 9(3) COMP VALUE 10.
       01  HEADING-1.
           05  FILLER           PIC X(26) VALUE "CBLEDGER ACCOUNT LIST".
           05  FILLER           PIC X(9)  VALUE "RUN DATE ".
           05  HD-DATE          PIC X(10).
           05  FILLER           PIC X(5)  VALUE " PAGE".
           05  HD-PAGE          PIC ZZZ9.
       01  HEADING-2.
           05  FILLER           PIC X(10) VALUE "ACCT ID".
           05  FILLER           PIC X(22) VALUE "NAME".
           05  FILLER           PIC X(9)  VALUE "TYPE".
           05  FILLER           PIC X(8)  VALUE "STATUS".
           05  FILLER           PIC X(15) VALUE "        BALANCE".
           05  FILLER           PIC X(6)  VALUE "  TXNS".
       01  RULE-LINE            PIC X(70) VALUE ALL "-".
       01  DETAIL-LINE.
           05  DL-ID            PIC 9(8).
           05  FILLER           PIC XX VALUE SPACES.
           05  DL-NAME          PIC X(20).
           05  FILLER           PIC XX VALUE SPACES.
           05  DL-TYPE          PIC X(8).
           05  FILLER           PIC X VALUE SPACE.
           05  DL-STATUS        PIC X(8).
           05  DL-BALANCE       PIC -ZZZ,ZZZ,ZZ9.99.
           05  FILLER           PIC XX VALUE SPACES.
           05  DL-TXNS          PIC ZZZ9.
       01  TOTAL-LINE.
           05  TL-LABEL         PIC X(45).
           05  TL-AMOUNT        PIC -ZZ,ZZZ,ZZZ,ZZ9.99.
       01  STAT-LINE.
           05  SL-LABEL         PIC X(40).
           05  SL-VALUE         PIC ZZZ,ZZ9.
       01  REASON-TEXT-TABLE.
           05  REASON-TEXT      PIC X(26) OCCURS 20 TIMES.
       01  WS-RX                PIC 99.
       LINKAGE SECTION.
           COPY ACCTTBL.
           COPY STATS.
       01  LK-PATH              PIC X(100).
       01  LK-RUN-DATE          PIC X(8).
       PROCEDURE DIVISION USING ACCT-TABLE LEDGER-STATS LK-PATH
           LK-RUN-DATE.
       MAIN-LINE.
           MOVE LK-PATH TO WS-PATH
           STRING LK-RUN-DATE (1:4) "-" LK-RUN-DATE (5:2) "-"
               LK-RUN-DATE (7:2) DELIMITED BY SIZE INTO HD-DATE
           OPEN OUTPUT REPORT-FILE
           PERFORM VARYING WS-IX FROM 1 BY 1 UNTIL WS-IX > AT-COUNT
               PERFORM PRINT-DETAIL
           END-PERFORM
           PERFORM PRINT-TOTALS
           PERFORM PRINT-STATS
           CLOSE REPORT-FILE
           GOBACK.

       PRINT-HEADINGS.
           ADD 1 TO WS-PAGE-NO
           MOVE WS-PAGE-NO TO HD-PAGE
           IF WS-PAGE-NO > 1
               MOVE SPACES TO REPORT-REC
               WRITE REPORT-REC
           END-IF
           WRITE REPORT-REC FROM HEADING-1
           WRITE REPORT-REC FROM HEADING-2
           WRITE REPORT-REC FROM RULE-LINE
           MOVE 0 TO WS-LINE-COUNT.

       PRINT-DETAIL.
           IF WS-LINE-COUNT = 0 OR WS-LINE-COUNT >= WS-PAGE-SIZE
               PERFORM PRINT-HEADINGS
           END-IF
           MOVE AT-ID (WS-IX) TO DL-ID
           MOVE AT-NAME (WS-IX) TO DL-NAME
           IF AT-TYPE (WS-IX) = "C"
               MOVE "CHECKING" TO DL-TYPE
               ADD AT-BALANCE (WS-IX) TO WS-TOT-CHECKING
           ELSE
               MOVE "SAVINGS" TO DL-TYPE
               ADD AT-BALANCE (WS-IX) TO WS-TOT-SAVINGS
           END-IF
           EVALUATE TRUE
               WHEN AT-FROZEN (WS-IX)
                   MOVE "FROZEN" TO DL-STATUS
                   ADD 1 TO WS-N-FROZEN
               WHEN AT-CLOSED (WS-IX)
                   MOVE "CLOSED" TO DL-STATUS
                   ADD 1 TO WS-N-CLOSED
               WHEN OTHER
                   MOVE "ACTIVE" TO DL-STATUS
           END-EVALUATE
           MOVE AT-BALANCE (WS-IX) TO DL-BALANCE
           MOVE AT-TXN-COUNT (WS-IX) TO DL-TXNS
           WRITE REPORT-REC FROM DETAIL-LINE
           ADD 1 TO WS-LINE-COUNT.

       PRINT-TOTALS.
           WRITE REPORT-REC FROM RULE-LINE
           MOVE "TOTAL CHECKING" TO TL-LABEL
           MOVE WS-TOT-CHECKING TO TL-AMOUNT
           WRITE REPORT-REC FROM TOTAL-LINE
           MOVE "TOTAL SAVINGS" TO TL-LABEL
           MOVE WS-TOT-SAVINGS TO TL-AMOUNT
           WRITE REPORT-REC FROM TOTAL-LINE
           MOVE "FROZEN ACCOUNTS" TO SL-LABEL
           MOVE WS-N-FROZEN TO SL-VALUE
           WRITE REPORT-REC FROM STAT-LINE
           MOVE "CLOSED ACCOUNTS" TO SL-LABEL
           MOVE WS-N-CLOSED TO SL-VALUE
           WRITE REPORT-REC FROM STAT-LINE.

       PRINT-STATS.
           MOVE SPACES TO REPORT-REC
           WRITE REPORT-REC
           MOVE "TRANSACTIONS READ" TO SL-LABEL
           MOVE ST-READ TO SL-VALUE
           WRITE REPORT-REC FROM STAT-LINE
           MOVE "TRANSACTIONS APPLIED" TO SL-LABEL
           MOVE ST-APPLIED TO SL-VALUE
           WRITE REPORT-REC FROM STAT-LINE
           MOVE "TRANSACTIONS REJECTED" TO SL-LABEL
           MOVE ST-REJECTED TO SL-VALUE
           WRITE REPORT-REC FROM STAT-LINE
           PERFORM PRINT-REASONS
           IF ST-INTEREST-TOTAL > 0
               MOVE "INTEREST POSTED" TO TL-LABEL
               MOVE ST-INTEREST-TOTAL TO TL-AMOUNT
               WRITE REPORT-REC FROM TOTAL-LINE
           END-IF
           MOVE SPACES TO REPORT-REC
           WRITE REPORT-REC
           MOVE "OPENING BALANCE TOTAL" TO TL-LABEL
           MOVE ST-OPENING-TOTAL TO TL-AMOUNT
           WRITE REPORT-REC FROM TOTAL-LINE
           MOVE "CLOSING BALANCE TOTAL" TO TL-LABEL
           MOVE ST-CLOSING-TOTAL TO TL-AMOUNT
           WRITE REPORT-REC FROM TOTAL-LINE.

       PRINT-REASONS.
           PERFORM LOAD-REASON-TEXTS
           PERFORM VARYING WS-RX FROM 1 BY 1 UNTIL WS-RX > 20
               IF ST-REASON-COUNT (WS-RX) > 0
                   MOVE SPACES TO SL-LABEL
                   STRING "  REJECTED " WS-RX " " REASON-TEXT (WS-RX)
                       DELIMITED BY SIZE INTO SL-LABEL
                   MOVE ST-REASON-COUNT (WS-RX) TO SL-VALUE
                   WRITE REPORT-REC FROM STAT-LINE
               END-IF
           END-PERFORM.

       LOAD-REASON-TEXTS.
           MOVE "UNKNOWN ACCOUNT" TO REASON-TEXT (1)
           MOVE "INSUFFICIENT FUNDS" TO REASON-TEXT (2)
           MOVE "ACCOUNT FROZEN" TO REASON-TEXT (3)
           MOVE "ACCOUNT CLOSED" TO REASON-TEXT (4)
           MOVE "UNKNOWN TRANSACTION TYPE" TO REASON-TEXT (5)
           MOVE "INVALID DATE" TO REASON-TEXT (6)
           MOVE "ZERO AMOUNT" TO REASON-TEXT (7)
           MOVE "TRANSFER TO SAME ACCOUNT" TO REASON-TEXT (8)
           MOVE "UNKNOWN TRANSFER TARGET" TO REASON-TEXT (9)
           MOVE "OVER WITHDRAWAL LIMIT" TO REASON-TEXT (10)
           MOVE "DATED AFTER THE RUN DATE" TO REASON-TEXT (11)
           MOVE "BALANCE WOULD OVERFLOW" TO REASON-TEXT (12)
           MOVE "TARGET BALANCE OVERFLOW" TO REASON-TEXT (13)
           MOVE "BEFORE ACCOUNT OPENING" TO REASON-TEXT (14)
           MOVE "REPEATED SEQUENCE NUMBER" TO REASON-TEXT (15).

       END PROGRAM RPTWRT.
